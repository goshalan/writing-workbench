# Copy to .env only if your process manager loads it. The app never writes this file.
WRITING_WORKBENCH_DIR=./manuscripts
WRITING_WORKBENCH_HOST=127.0.0.1
WRITING_WORKBENCH_PORT=8787
WRITING_WORKBENCH_MAX_REQUEST_BYTES=2097152
WRITING_WORKBENCH_MAX_FILE_BYTES=1900000
WRITING_WORKBENCH_BACKUP_LIMIT=10

# off (disabled), mock (local demo), or openai-compatible (remote)
WRITING_WORKBENCH_AI_PROVIDER=mock

# Remote provider placeholders. The key is read from the environment only.
WRITING_WORKBENCH_OPENAI_BASE_URL=https://api.example.invalid/v1
WRITING_WORKBENCH_OPENAI_API_KEY=replace-with-a-local-environment-value
WRITING_WORKBENCH_OPENAI_MODEL=replace-with-a-model-name
WRITING_WORKBENCH_AI_TIMEOUT=30
