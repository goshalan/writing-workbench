# Copy to .env only if your process manager loads it. The app never writes this file.
WRITING_WORKBENCH_DIR=./manuscripts
WRITING_WORKBENCH_HOST=127.0.0.1
WRITING_WORKBENCH_PORT=8787
WRITING_WORKBENCH_MAX_REQUEST_BYTES=2097152
WRITING_WORKBENCH_MAX_FILE_BYTES=1900000
WRITING_WORKBENCH_BACKUP_LIMIT=10
WRITING_WORKBENCH_CREATE_EXAMPLES=true
WRITING_WORKBENCH_BOOK_TITLE=
WRITING_WORKBENCH_TARGET_WORDS=80000

# Optional host-dashboard integration. Leave blank for standalone use.
WRITING_WORKBENCH_SUITE_HOME_URL=
WRITING_WORKBENCH_SUITE_HOME_LABEL=Back to local tools
WRITING_WORKBENCH_SUITE_MARK=WW

# hermes (local agent), mock (local deterministic demo), or off (disabled)
WRITING_WORKBENCH_AI_PROVIDER=hermes
WRITING_WORKBENCH_HERMES_COMMAND=hermes
# Optional: leave blank to use Hermes' current default profile.
WRITING_WORKBENCH_HERMES_PROFILE=
WRITING_WORKBENCH_AI_TIMEOUT=120
WRITING_WORKBENCH_ANALYSIS_CONTEXT_CHARS=100000
